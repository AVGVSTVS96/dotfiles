#!/bin/sh
# twin-up: makes a fresh Arch Linux cloud machine the server's twin (scripts/.local/bin/standby). Run once as root,
# with the server reachable over Tailscale:
#   TS_AUTHKEY=tskey-... SERVER_ID=<server's Syncthing id> GROW='...' SHRINK='...' sh twin-up
# It makes the server's user with the same home, joins the tailnet as `twin`, and has Syncthing bring over hex,
# Claude Code's data, ~/Developer, hangar's builds, dotfiles, ~/.local/bin, the account pool's logins and the vault. Everything that
# holds hex stays off until standby takes over.
set -eu
user=bassim
: "${TS_AUTHKEY:=}" "${SERVER_ID:?the Syncthing device id of the server}"

# The server's packages, less its desktop.
pacman-key --init && pacman-key --populate archlinux
pacman -Syu --noconfirm --needed base-devel git openssh sudo tailscale syncthing jq sqlite stow fish zsh tmux \
  bun nodejs npm pnpm uv rustup go ripgrep fd bat eza fzf git-delta git-lfs github-cli jujutsu neovim unzip zip nftables \
  ffmpeg imagemagick shellcheck sops age xorg-server-xvfb

# Swap, so a burst on the small size doesn't kill Syncthing.
[ -f /swapfile ] || { fallocate -l 4G /swapfile && chmod 600 /swapfile && mkswap /swapfile && echo '/swapfile none swap defaults 0 0' >> /etc/fstab; }
swapon -a || :
# Syncthing watches every folder it keeps.
echo 'fs.inotify.max_user_watches=1048576' > /etc/sysctl.d/90-syncthing.conf && sysctl --system >/dev/null

id "$user" >/dev/null 2>&1 || useradd -m -s /usr/bin/fish "$user"
echo "$user ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/$user"
loginctl enable-linger "$user"

systemctl enable --now tailscaled sshd
tailscale status >/dev/null 2>&1 || tailscale up --auth-key="$TS_AUTHKEY" --hostname=twin
# Claude Code finds the account pool at the server's tailnet address: here that port goes to the twin's own copy,
# which listens on 127.0.0.1 too, while ssh, scp and Syncthing still reach the server itself.
printf 'destroy table ip twin\ntable ip twin {\n  chain out {\n    type nat hook output priority -100;\n    ip daddr %s tcp dport 8317 redirect to :8317\n  }\n}\n' \
  "$(tailscale ip -4 server)" > /etc/nftables.conf
systemctl enable nftables
# A kernel the upgrade above replaced can't load nftables until the next boot.
nft -f /etc/nftables.conf 2>/dev/null || echo 'twin-up: the redirect starts once the twin reboots onto its new kernel'

sudo -iu "$user" sh -s "$SERVER_ID" "${GROW:-}" "${SHRINK:-}" <<'AS_USER'
set -eu
server_id=$1
export XDG_RUNTIME_DIR=/run/user/$(id -u)
mkdir -p ~/hex ~/.claude ~/Developer ~/dotfiles ~/.local/bin ~/.config/cliproxyapi ~/.enclave ~/.local/share/hex-voice ~/.local/share/hangar ~/.config/systemd/user/cliproxyapi.socket.d
printf '[Socket]\nListenStream=127.0.0.1:8317\n' > ~/.config/systemd/user/cliproxyapi.socket.d/twin.conf
printf 'ROLE=twin\nSERVER=server\nGROW=%s\nSHRINK=%s\n' "'$2'" "'$3'" > ~/.config/standby.env
curl -fsSL https://claude.ai/install.sh | bash

# Syncthing: only over the tailnet, and only with the server.
systemctl --user enable --now syncthing.service
until syncthing cli show system >/dev/null 2>&1; do sleep 1; done
st() { syncthing cli "$@"; }
for f in $(st config folders list); do st config folders "$f" delete; done
st config options global-ann-enabled set false
st config options local-ann-enabled set false
st config options relays-enabled set false
st config options natenabled set false
st config options uraccepted set -- -1
st config options raw-listen-addresses 0 set "tcp://$(tailscale ip -4):22000"
st config devices add --device-id "$server_id" --name server --addresses tcp://server:22000
for spec in hex:hex claude:.claude dev:Developer dotfiles:dotfiles bin:.local/bin proxy:.config/cliproxyapi enclave:.enclave voice:.local/share/hex-voice hangar:.local/share/hangar; do
  st config folders add --id "${spec%%:*}" --label "${spec%%:*}" --path "$HOME/${spec#*:}"
  st config folders "${spec%%:*}" devices add --device-id "$server_id"
done
echo "twin's Syncthing id: $(st show system | jq -r .myID)"
AS_USER
echo "twin-up: done. Copy the server's ~/.ssh and each folder's .stignore here (both machines ssh each other as bassim), add the twin's Syncthing id to the server, then once the first sync finishes:"
echo "  sudo -iu $user sh -c '~/dotfiles/install && systemctl --user daemon-reload && systemctl --user enable --now standby.service'"
