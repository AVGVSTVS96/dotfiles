#!/bin/sh
# twin-up: makes a fresh Arch Linux cloud machine the server's twin (standby: github.com/AVGVSTVS96/standby, set up by hex restore). Run once as root,
# with the server reachable over Tailscale:
#   TS_AUTHKEY=tskey-... SERVER_ID=<server's Syncthing id> sh twin-up
# It makes the server's user with the same home, joins the tailnet as `twin`, and has Syncthing bring over hex,
# Claude Code's data, ~/Developer, hangar's builds, hex Exact's and iikb's install links, dotfiles, ~/.local/bin, the account pool's logins and the vault, and git-peer brings each repo's history by git. Everything that
# holds hex stays off until standby takes over.
set -eu
user=bassim
: "${TS_AUTHKEY:=}" "${SERVER_ID:?the Syncthing device id of the server}"

# What the twin needs to bring hex over and set it up; hex restore brings the rest of what hex uses, from
# ~/hex/services.json. Xvfb is the twin's own: a screen for programs that want one.
pacman-key --init && pacman-key --populate archlinux
pacman -Syu --noconfirm --needed base-devel git openssh sudo tailscale syncthing jq stow fish zsh bun nodejs npm go \
  python sops age unzip xorg-server-xvfb zram-generator

# Compressed swap in memory, so the sessions hex keeps idle fit beside its work at the twin's size.
printf '[zram0]\nzram-size = ram / 2\ncompression-algorithm = zstd\n' > /etc/systemd/zram-generator.conf
systemctl daemon-reload && systemctl start dev-zram0.swap
# Syncthing watches every folder it keeps.
echo 'fs.inotify.max_user_watches=1048576' > /etc/sysctl.d/90-syncthing.conf && sysctl --system >/dev/null

id "$user" >/dev/null 2>&1 || useradd -m -s /usr/bin/fish "$user"
echo "$user ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/$user"
loginctl enable-linger "$user"

systemctl enable --now tailscaled sshd
tailscale status >/dev/null 2>&1 || tailscale up --auth-key="$TS_AUTHKEY" --hostname=twin
# The tailnet names that follow hex are hex's own: hex-here.service sets them on whichever machine holds it
# (~/hex/services/routes), as this user.
tailscale set --operator="$user"

sudo -u "$user" -H sh -s "$SERVER_ID" <<'AS_USER'
set -eu
cd && server_id=$1
export XDG_RUNTIME_DIR=/run/user/$(id -u)
mkdir -p ~/hex ~/.claude ~/Developer ~/dotfiles ~/.local/bin ~/.config/cliproxyapi ~/.enclave ~/.local/share/hex-voice ~/.local/share/hangar ~/.local/share/hex-exact/link ~/.local/share/iikb/link
echo ROLE=twin > ~/.config/standby.env
curl -fsSL https://claude.ai/install.sh | bash

# Syncthing: only over the tailnet, and only with the server.
systemctl --user enable --now syncthing.service
until syncthing cli show system >/dev/null 2>&1; do sleep 1; done
st() { syncthing cli "$@"; }
for f in $(st config folders list); do st config folders "$f" delete; done
st config options global-ann-enabled set false
st config options local-ann-enabled set false
st config options relays-enabled set false
st config options natenabled set false
st config options uraccepted set -- -1
st config options raw-listen-addresses 0 set "tcp://$(tailscale ip -4):22000"
# One connection: with several, a loaded machine drops some, the two ends disagree on which is primary, and each
# drops the other's updates in a loop (the twin and server synced nothing from 4:27 to 6:04am on Nov 16, 2026).
st config devices add --device-id "$server_id" --name server --addresses tcp://server:22000 --raw-num-connections 1
for spec in hex:hex claude:.claude dev:Developer dotfiles:dotfiles bin:.local/bin proxy:.config/cliproxyapi enclave:.enclave voice:.local/share/hex-voice hangar:.local/share/hangar exact:.local/share/hex-exact/link iikb-link:.local/share/iikb/link; do
  st config folders add --id "${spec%%:*}" --label "${spec%%:*}" --path "$HOME/${spec#*:}"
  st config folders "${spec%%:*}" devices add --device-id "$server_id"
done
echo "twin's Syncthing id: $(st show system | jq -r .myID)"
AS_USER
echo "twin-up: done. Copy the server's ~/.ssh here (both machines ssh each other as bassim), add the twin's Syncthing id to the server, then once the first sync finishes (install puts each folder's Syncthing ignore file in place):"
echo "  sudo -iu $user sh -c '~/dotfiles/install && ~/hex/.hex/bin/hex restore; systemctl --user enable --now systemd-tmpfiles-clean.timer'"
echo "(hex restore sets up what ~/hex/services.json lists, Caddy included; its doctor says the hub waits, since the server holds hex)."
