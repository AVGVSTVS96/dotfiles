#!/usr/bin/env bash
# standby/test: runs standby's hand-back and the server's guard between two pretend machines, "server" and "twin",
# each a folder standing in for its home, with stand-ins for systemctl, ssh, rsync, tailscale, sqlite3 and logind.
# Nothing real is started or stopped. Usage: sh standby/test
set -u
standby=$(cd "$(dirname "$0")/.." && pwd)/scripts/.local/bin/standby
root=$(mktemp -d)
trap '[ -n "${KEEP:-}" ] || rm -rf "$root"' EXIT
bin=$root/bin
mkdir -p "$bin"
pass=0 fail=0
check() { if eval "$2"; then pass=$((pass + 1)); echo "  ok   $1"; else fail=$((fail + 1)); echo "  FAIL $1"; fi; }

# systemctl --user: hex-holder.target and hex.service start hex.service only where standby may-hold says so, as
# ExecCondition does, and not at all on a machine with a file named broken; a start while hex-ahead is there is noted
# in started. As they stop, the hub writes to hex.db's WAL and a session to its recent transcript, if there are those.
cat > "$bin/systemctl" <<'EOF'
#!/usr/bin/env bash
[ "$1" = --user ] && shift
units=$HOME/units
ahead=$HOME/.local/state/standby/hex-ahead
case $1 in
  start) case $2 in hex-holder.target | hex.service) ;; *) exit 0 ;; esac
    [ ! -f "$HOME/broken" ] && "$HOME/.local/bin/standby" may-hold || exit
    grep -qx hex.service "$units" 2>/dev/null || { echo hex.service >> "$units"; [ ! -f "$ahead" ] || { echo ahead >> "$HOME/started"; [ -f "$HOME/hub-dies" ] || echo ready > "$ahead"; }; } ;;
  stop) case " $* " in *" hex-jobs.slice "*) sed -i '/^hex-jobs.slice$/d' "$units" 2>/dev/null ;; esac
    for unit in "${@:2}"; do case $unit in hex*) ;; *) sed -i "/^$unit\$/d" "$units" 2>/dev/null ;; esac; done
    case " $* " in *" hex-holder.target "* | *" hex.service "*)
      grep -qx hex.service "$units" 2>/dev/null && [ -f "$HOME/hex/state/hex.db-wal" ] && echo "last write" >> "$HOME/hex/state/hex.db-wal"
      sed -i '/^hex.service$/d' "$units" 2>/dev/null ;; esac
      ;;
  kill) case " $* " in *" hex-jobs.slice "*) sed -i '/^hex-jobs.slice$/d' "$units" 2>/dev/null ;; esac
    case " $* " in *" hex-sessions.slice "*) find "$HOME/.claude/projects" -name '*.jsonl' -mmin -10 -exec sh -c 'echo last >> "$1"' _ {} \; 2>/dev/null ;; esac ;;
  is-active) shift; [ "$1" = -q ] && shift; grep -qx "$1" "$units" 2>/dev/null; exit ;;
  list-units) grep -vx 'hex.*' "$units" 2>/dev/null | sed 's/$/.service loaded active running job/'; exit ;;
  show) case " $* " in *" -p Slice "*) shift; for unit; do case $unit in -p | Id | Slice) ;; *) printf 'Id=%s\nSlice=hex-jobs.slice\n\n' "$unit" ;; esac; done ;;
      *" hex-jobs.slice "*) grep -qx hex-jobs.slice "$units" 2>/dev/null && echo 3 || echo 0 ;;
      *) grep -qx hex.service "$units" 2>/dev/null && echo 1 || echo 0 ;; esac; exit ;;
esac
exit 0
EOF
# ssh <options> <host> <command>: runs the command as the other machine, as long as that machine is reachable.
cat > "$bin/ssh" <<'EOF'
#!/usr/bin/env bash
while [ "${1#-}" != "$1" ]; do shift 2; done
host=$1; shift
[ ! -f "$ROOT/$host/down" ] || exit 255
HOME=$ROOT/$host exec bash -c "$*"
EOF
# rsync to <host>:<path>: one file (hex.db), or the files named on its input (the last transcripts).
cat > "$bin/rsync" <<'EOF'
#!/usr/bin/env bash
to=${*: -1} from=${*: -2:1}
host=${to%%:*}
[ ! -f "$ROOT/$host/down" ] && [ ! -f "$HOME/copy-fails" ] || exit 1
case " $* " in
  *" --files-from=- "*) while IFS= read -r -d '' file; do mkdir -p "$ROOT/$host/${file%/*}" && cp "$file" "$ROOT/$host/$file"; done ;;
  *) mkdir -p "$ROOT/$host/$(dirname "${to#*:}")" && cp "$from" "$ROOT/$host/${to#*:}" ;;
esac
EOF
printf '#!/bin/sh\nexit 0\n' > "$bin/sqlite3"
cat > "$bin/tailscale" <<'EOF'
#!/usr/bin/env bash
[ "$1" = serve ] && echo "$2" >> "$HOME/names.$3"
exit 0
EOF
# A running hex.service has a hub that's been up 100 seconds, except on a machine with a file named hub-dies.
printf '#!/bin/sh\n[ ! -f "$HOME/hub-dies" ] && echo 2\n' > "$bin/pgrep"
printf '#!/bin/sh\necho 100\n' > "$bin/ps"
# logind: a machine with a file named shutdown is going down, and one with a file named sleep is going to sleep.
printf '#!/bin/sh\nexec sleep 5\n' > "$bin/systemd-inhibit"
cat > "$bin/gdbus" <<'EOF'
#!/usr/bin/env bash
[ ! -f "$HOME/shutdown" ] || echo "/org/freedesktop/login1: org.freedesktop.login1.Manager.PrepareForShutdown (true,)"
[ ! -f "$HOME/sleep" ] || echo "/org/freedesktop/login1: org.freedesktop.login1.Manager.PrepareForSleep (true,)"
exec sleep 60
EOF
# Each pretend machine is named for its folder.
printf '#!/bin/sh\nbasename "$HOME"\n' > "$bin/uname"
printf '#!/bin/sh\nexit 0\n' > "$bin/claude"
printf '#!/bin/sh\nexit 0\n' > "$bin/bun"
# A hub that starts says it polls, except on a machine with a file named hub-dies.
printf '#!/bin/sh\n[ -f "$HOME/hub-dies" ] || echo "telegram hub: polling as @bot"\n' > "$bin/journalctl"
chmod +x "$bin"/*
export PATH=$bin:$PATH ROOT=$root
unset XDG_RUNTIME_DIR

# Fresh machines: the twin holds hex, the server's is stopped (fenced), as after an outage.
setup() {
  rm -rf "$root/server" "$root/twin"
  for host in server twin; do
    mkdir -p "$root/$host/.local/bin" "$root/$host/.config" "$root/$host/hex/state" "$root/$host/.local/state/standby"
    ln -s "$standby" "$root/$host/.local/bin/standby"
    mkdir -p "$root/$host/hex/.hex/bin" && echo 'HEX_AHEAD' > "$root/$host/hex/.hex/bin/hex"
    echo 'hex/elsewhere' > "$root/$host/hex/.hex/bin/job.ts"
    echo "$host data" > "$root/$host/hex/state/hex.db"
  done
  # The server streams its copies of hex.db to the twin as a folder of that name (hex-db.service).
  mkdir -p "$root/twin/.local/state/standby/hex.db"
  printf 'ROLE=server\nTWIN=twin\nEVERY=0\nSTUCK=1\n' > "$root/server/.config/standby.env"
  printf 'ROLE=twin\nSERVER=server\nBIG_CPUS=1\n' > "$root/twin/.config/standby.env"
  echo twin > "$root/twin/.local/state/standby/holder"
  echo hex.service > "$root/twin/units"
}
as() { local host=$1; shift; HOME=$root/$host "$@"; }
# Every name that follows hex, svc:gate (https://<name>.bassim.run) among them, was last advertised or drained here.
names() { for service in svc:hub svc:pages svc:updates svc:gate; do [ "$(tail -1 "$root/$1/names.$service" 2>/dev/null)" = "$2" ] || return; done; }
active() { grep -qx hex.service "$root/$1/units" 2>/dev/null; }
# A machine running jobs has hex-jobs.slice among its units.
working() { grep -qx hex-jobs.slice "$root/$1/units" 2>/dev/null; }
where() { cat "$root/$1/.local/state/hex/elsewhere" 2>/dev/null; }
holder() { cat "$root/twin/.local/state/standby/holder"; }

echo "hand-back"
setup
echo hex-jobs.slice >> "$root/twin/units"
mkdir -p "$root/server/.local/state/hex" && echo twin > "$root/server/.local/state/hex/elsewhere"
echo "SHRINK='touch $root/twin/shrunk'" >> "$root/twin/.config/standby.env"
as twin "$standby" give >"$root/log" 2>&1
check "the server runs hex" "active server"
check "the twin doesn't" "! active twin"
check "the server has the twin's hex.db" "grep -q 'twin data' '$root/server/hex/state/hex.db'"
check "the server serves hex's names, bassim.run's among them" "names server advertise"
check "the twin drained them" "names twin drain"
check "the twin says the server holds" "[ \"\$(holder)\" = server ]"
check "the twin's jobs keep running there" "working twin"
check "and know hex runs on the server" "[ \"\$(where twin)\" = server ]"
check "the server no longer points elsewhere" "[ -z \"\$(where server)\" ]"
check "the twin waits for its jobs before it shrinks" "[ ! -e '$root/twin/shrunk' ]"
as twin timeout 2 "$standby" watch >/dev/null 2>&1
check "and stays its size while they run" "[ ! -e '$root/twin/shrunk' ]"
sed -i '/^hex-jobs.slice$/d' "$root/twin/units"
as twin timeout 2 "$standby" watch >/dev/null 2>&1
check "then shrinks once they end" "[ -e '$root/twin/shrunk' ]"

echo "hand-back right after a transcript was written"
setup
mkdir -p "$root/twin/.claude/projects/-home-bassim-hex" "$root/twin/.claude/projects/old"
echo turn > "$root/twin/.claude/projects/-home-bassim-hex/a b.jsonl"
echo old > "$root/twin/.claude/projects/old/old.jsonl"
echo half > "$root/twin/.claude/projects/-home-bassim-hex/.syncthing.c.jsonl.tmp"
touch -d '-2 days' "$root/twin/.claude/projects/old/old.jsonl"
as twin "$standby" give >"$root/log" 2>&1
check "the server has the transcript, with what its session wrote as it stopped" "[ \"\$(cat '$root/server/.claude/projects/-home-bassim-hex/a b.jsonl')\" = \"\$(printf 'turn\\nlast')\" ]"
check "older ones are left to Syncthing" "[ ! -e '$root/server/.claude/projects/old/old.jsonl' ]"
check "so are Syncthing's half-written copies" "[ ! -e '$root/server/.claude/projects/-home-bassim-hex/.syncthing.c.jsonl.tmp' ]"
check "the twin is no longer marked as moving" "[ ! -e '$root/twin/hex/state/moving' ]"

echo "hand-back whose copy of hex.db fails"
setup
touch "$root/twin/copy-fails"
as twin "$standby" give >"$root/log" 2>&1
check "the twin keeps running hex" "active twin && ! active server"
check "from its own hex.db" "grep -q 'twin data' '$root/twin/hex/state/hex.db'"
check "the twin still holds" "[ \"\$(holder)\" = twin ]"

echo "hand-back to a server whose hex can't start"
setup
touch "$root/server/hub-dies"
as twin "$standby" give >"$root/log" 2>&1
check "the twin runs hex again" "active twin && ! active server"
check "the twin still holds" "[ \"\$(holder)\" = twin ]"

echo "hand-back to a server that went away again"
setup
touch "$root/server/down"
as twin "$standby" give >"$root/log" 2>&1
check "the twin runs hex again" "active twin"
check "and serves hex's names" "names twin advertise"
check "the twin still holds" "[ \"\$(holder)\" = twin ]"

echo "server guard"
setup
printf 'hex.service\nhex-jobs.slice\n' > "$root/server/units"
as server timeout 2 "$standby" watch >/dev/null 2>&1
check "stops the server's hex while the twin holds" "! active server"
setup
printf 'hex.service\nhex-jobs.slice\n' > "$root/server/units"
printf '#!/bin/sh\necho resumed > "$HOME/resumed"\n' > "$root/twin/hex/.hex/bin/job" && chmod +x "$root/twin/hex/.hex/bin/job"
as server timeout 2 "$standby" watch >/dev/null 2>&1
check "stops the jobs of that stale hex" "! working server"
check "and the twin carries them on" "[ -e '$root/twin/resumed' ]"
check "which reaches hex on the twin" "[ \"\$(where server)\" = twin ]"
setup
echo giving > "$root/twin/.local/state/standby/holder"
as server timeout 3 "$standby" watch >/dev/null 2>&1
check "starts it when a hand-back is stuck" "active server"
setup
touch "$root/twin/down"
as server timeout 2 "$standby" watch >/dev/null 2>&1
check "starts it when the twin can't be reached" "active server"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
as server timeout 2 "$standby" watch >/dev/null 2>&1
check "starts it when no machine holds hex" "active server"

echo "drill"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
printf 'hex.service\nhex-jobs.slice\n' > "$root/server/units"
printf 'GRACE=0\nSTABLE=0\nEVERY=0\n' >> "$root/twin/.config/standby.env"
as twin "$standby" drill
as twin timeout 3 "$standby" watch >/dev/null 2>&1
check "the twin takes over while the server answers" "active twin && [ \"\$(holder)\" = twin ]"
as server timeout 2 "$standby" watch >/dev/null 2>&1
check "the server's guard stops its hex" "! active server"
check "and moves its jobs to the twin, as an outage would" "! working server"
as twin "$standby" drill off
as twin timeout 3 "$standby" watch >/dev/null 2>&1
check "after the drill hex goes back to the server" "active server && ! active twin && [ \"\$(holder)\" = server ]"

echo "jump"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
printf 'hex.service\nhex-jobs.slice\n' > "$root/server/units"
echo "server wal" > "$root/server/hex/state/hex.db-wal"
as server "$standby" jump >"$root/log" 2>&1
check "hex runs on the twin" "active twin && ! active server && [ \"\$(holder)\" = twin ]"
check "the server's jobs keep running there" "working server"
check "and know hex runs on the twin" "[ \"\$(where server)\" = twin ]"
as twin timeout 2 "$standby" watch >/dev/null 2>&1
check "the twin's watch leaves them running" "working server"
check "from the server's hex.db" "grep -q 'server data' '$root/twin/hex/state/hex.db'"
check "and its WAL, with the hub's last write" "[ \"\$(cat '$root/twin/hex/state/hex.db-wal')\" = \"\$(printf 'server wal\\nlast write')\" ]"
check "the twin's hex started ahead of the cut" "grep -qx ahead '$root/twin/started'"
check "and goes now" "[ ! -e '$root/twin/.local/state/standby/hex-ahead' ]"
check "the twin serves hex's names, bassim.run's among them" "names twin advertise"
check "the server drained them" "names server drain"

echo "jump with a hex that doesn't know jobs can stay"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
printf 'hex.service\nhex-jobs.slice\n' > "$root/server/units"
: > "$root/server/hex/.hex/bin/job.ts"
as server "$standby" jump >"$root/log" 2>&1
check "moves its jobs as before" "active twin && ! working server && [ -z \"\$(where server)\" ]"

echo "jump while the twin already holds"
setup
printf 'hex-jobs.slice\n' > "$root/server/units"
as server "$standby" jump >"$root/log" 2>&1
check "no second hex starts on the server" "! active server && active twin"
check "the server's jobs keep running" "working server"
setup
printf 'hex-jobs.slice\n' > "$root/server/units"
printf '#!/bin/sh\necho resumed > "$HOME/resumed"\n' > "$root/twin/hex/.hex/bin/job" && chmod +x "$root/twin/hex/.hex/bin/job"
touch "$root/server/shutdown"
as server timeout 3 "$standby" watch >/dev/null 2>&1
check "a shutdown then stops them" "! working server && ! active server"
check "and the twin carries them on" "[ -e '$root/twin/resumed' ]"

echo "jump to a twin whose hex can't start ahead"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
echo old > "$root/twin/hex/.hex/bin/hex"
as server "$standby" jump >"$root/log" 2>&1
check "hex keeps running on the server" "active server && ! active twin && [ \"\$(holder)\" = server ]"

echo "jump to a twin whose hex can't start"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
touch "$root/twin/hub-dies"
as server "$standby" jump >"$root/log" 2>&1
check "hex runs on the server again" "active server && ! active twin && [ \"\$(holder)\" = server ]"

echo "jump to a twin that's gone"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
touch "$root/twin/down"
as server "$standby" jump >"$root/log" 2>&1
check "hex keeps running on the server" "active server && grep -q 'server data' '$root/server/hex/state/hex.db'"

echo "shutdown"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
echo hex-jobs.slice >> "$root/server/units"
touch "$root/server/shutdown"
as server timeout 3 "$standby" watch >/dev/null 2>&1
check "a reboot of the server moves hex to the twin first" "active twin && ! active server && [ \"\$(holder)\" = twin ]"
check "and its jobs with it" "! working server"

echo "sleep"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
touch "$root/server/sleep"
as server timeout 3 "$standby" watch >/dev/null 2>&1
check "a server going to sleep moves hex to the twin first" "active twin && ! active server && [ \"\$(holder)\" = twin ]"

echo "hex that can't run on the server"
setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
touch "$root/server/broken"
echo 'DEAD=3' >> "$root/server/.config/standby.env"
as server timeout 6 "$standby" watch >/dev/null 2>&1
check "jumps to the twin" "active twin && ! active server && [ \"\$(holder)\" = twin ]"

setup
echo server > "$root/twin/.local/state/standby/holder"
rm "$root/twin/units"
echo hex.service > "$root/server/units"
touch "$root/server/hub-dies"
echo 'DEAD=3' >> "$root/server/.config/standby.env"
as server timeout 6 "$standby" watch >/dev/null 2>&1
check "jumps when its unit looks active but its hub never stays up" "active twin && ! active server && [ \"\$(holder)\" = twin ]"

echo "$pass passed, $fail failed"
[ "$fail" = 0 ]
