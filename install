#!/bin/sh
# Stow the shared packages plus this OS's packages into $HOME.
# Stow flags pass through: ./install -nv previews, -R restows, -D unlinks.
set -eu
cd "$(dirname "$0")"

# Real directories, so stow links into them instead of folding the writes of
# installers, herdr's runtime state and restore-secrets into this repo.
mkdir -p "$HOME/.local/bin" "$HOME/.config/herdr"
[ -d "$HOME/.ssh" ] || mkdir -m 700 "$HOME/.ssh"

case "$(uname -s)" in
  Darwin) os="brew completions ghostty nushell pi zed zsh" ;;
  Linux)
    # Wallpaper downloads stay out of the repo; the machine's SSH access list stays its own.
    # Fish is the login shell, so zsh only gets .zshenv: agents' shell commands run in zsh.
    mkdir -p "$HOME/Pictures/Wallpapers"
    set -- --ignore=authorized_keys --ignore='\.zshrc' "$@"
    os="ghostty-linux niri noctalia wallpapers zsh"
    ;;
esac

stow --target="$HOME" --ignore='secrets\.env' "$@" $os \
  agent-browser bat fastfetch fish gh gh-dash git graphite herdr \
  lazygit nvim oh-my-posh scripts sops ssh tmux wezterm yazi
# Agent homes fill with sessions and installed skills, so only files are linked into them.
stow --target="$HOME" --no-folding "$@" agent-skills claude codex
