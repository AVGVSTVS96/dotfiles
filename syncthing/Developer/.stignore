// Build output and installs each machine makes for itself.
// Tools linked into ~/.local/bin run from these, on either machine.
!/enclave/node_modules
!/speed/node_modules
(?d)node_modules
(?d)target
(?d).next
(?d).turbo
(?d).venv
(?d).cache
(?d)DerivedData
(?d).build
*.sock
.~lock*
(?d)dist
(?d)build
// Browser and Electron caches, which each machine refills for itself.
(?d)Cache_Data
(?d)Code Cache
(?d)GPUCache
(?d)GrShaderCache
(?d)GraphiteDawnCache
(?d)DawnGraphiteCache
(?d)DawnWebGPUCache
(?d)ShaderCache
(?d)CacheStorage
(?d)ScriptCache
(?d)component_crx_cache
