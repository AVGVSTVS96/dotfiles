// Build output and installs each machine makes for itself.
// Tools linked into ~/.local/bin run from these, on either machine.
!/enclave/node_modules
!/speed/node_modules
(?d)node_modules
(?d)target
(?d).next
(?d).next-*
(?d).turbo
(?d).venv
(?d).cache
(?d)DerivedData
(?d).build
*.sock
.~lock*
(?d)dist
(?d)build
// Browser and Electron caches, which each machine refills for itself.
(?d)Cache_Data
(?d)Code Cache
(?d)GPUCache
(?d)GrShaderCache
(?d)GraphiteDawnCache
(?d)DawnGraphiteCache
(?d)DawnWebGPUCache
(?d)ShaderCache
(?d)CacheStorage
(?d)ScriptCache
(?d)component_crx_cache
// Public bulk downloads a project fetches again where it needs them, about 50 GB the twin's disk hasn't got:
// antibody's FEC filings and lobbying reports, denoise's raw photo sets (each file's source is in its index).
/antibody/data/fec
/antibody/data/lobbying
/denoise/eval/data/night-raw
/denoise/eval/data/rawpairs
/denoise/eval/data/raw-test
