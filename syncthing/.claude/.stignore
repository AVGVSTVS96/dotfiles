// Build output and installs each machine makes for itself.
(?d)node_modules
(?d)target
(?d).next
(?d).turbo
(?d).venv
(?d).cache
(?d)DerivedData
(?d).build
*.sock
.~lock*
// What each machine's Claude Code keeps for itself, except each job's state, which hex's Tasks reads wherever hex runs.
!/jobs/*/state.json
/jobs/*/*
/daemon*
/shell-snapshots
/telemetry
/statsig
/debug
/ide
/session-env
/paste-cache
/file-history
