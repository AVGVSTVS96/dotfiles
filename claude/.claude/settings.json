{
  "cleanupPeriodDays": 20000,
  "env": {
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "DISABLE_ZOXIDE": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://server:4318/v1/logs",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0",
    "ANTHROPIC_BASE_URL": "https://proxy.bassim.run",
    "CLAUDE_CODE_TMPDIR": "/home/bassim/.cache/claude-tmp"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "disableAutoMode": "disable"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/bassim/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pkill-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(?!AskUserQuestion$|ExitPlanMode$)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "launchctl kickstart gui/$(id -u)/dev.commonplace.sync > /dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "telegram@hex": false,
    "discord@hex": false,
    "buzz@hex": false,
    "voice@voicedev": false,
    "t3@hex": false,
    "pstack@cursor-plugins": true,
    "expo@claude-plugins-official": true,
    "hex@hex-next": false,
    "paper-desktop@paper": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "hex": {
      "source": {
        "source": "directory",
        "path": "/home/bassim/hex/.hex/channels"
      }
    },
    "voicedev": {
      "source": {
        "source": "directory",
        "path": "/home/bassim/Developer/hex/voicedev"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      },
      "autoUpdate": true
    },
    "hex-next": {
      "source": {
        "source": "directory",
        "path": "/home/bassim/Developer/hex-next"
      }
    },
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "outputStyle": "visual",
  "feedbackDrafts": "off",
  "subagentPromptCacheTtl": "1h",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 650000,
  "fastModePerSessionOptIn": true,
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "10m",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true,
  "compactingEnabled": true,
  "apiKeyHelper": "$HOME/.local/bin/claude-proxy-key"
}
