[Unit]
Description=hex keyboard: keeps every file iikb sends from the phone, never deleting one (behind tailscale serve /backup)

[Service]
WorkingDirectory=%h/Developer/hex-keyboard
EnvironmentFile=%h/.config/hex-keyboard/backup.env
ExecStart=/usr/bin/bun server/backup.ts --port 2592 --dir %h/.local/share/hex-keyboard/backup
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
