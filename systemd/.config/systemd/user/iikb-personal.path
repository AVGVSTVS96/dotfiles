[Unit]
Description=iikb: watches the record and the shipped network for the personal network
# Only on the server: it reads the record, which iikb-record keeps on this machine's disk.
ConditionHost=server

[Path]
PathChanged=%h/.local/share/iikb/record.jsonl
PathChanged=%h/Developer/iikb/Packages/KeyboardModules/Sources/KeyboardEnglish/Resources/en.network

[Install]
WantedBy=default.target
