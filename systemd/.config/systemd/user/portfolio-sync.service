[Unit]
Description=Refresh the portfolio's GitHub and npm data and redeploy it

[Service]
Type=oneshot
WorkingDirectory=%h/Developer/portfolio
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin
ExecStartPre=%h/.local/bin/vault-env hex-env %t/hex.env
EnvironmentFile=-%t/hex.env
ExecStart=%h/Developer/portfolio/scripts/deploy.sh
TimeoutStartSec=15min
