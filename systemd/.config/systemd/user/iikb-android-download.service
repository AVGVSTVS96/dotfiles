[Unit]
Description=iikb: deploys the newest Android APK to iikb-android.vercel.app

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin
ExecStart=/bin/sh -c 'git -C %h/Developer/iikb fetch -q origin main && git -C %h/Developer/iikb show origin/main:scripts/android-download | bash -s'
TimeoutStartSec=15min
