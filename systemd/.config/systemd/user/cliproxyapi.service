[Unit]
Description=cliproxyapi: Claude account pool, agent usage and its dashboard on the tailnet
After=network-online.target tailscaled.service
Requires=cliproxyapi.socket

[Service]
# About twice the live heap (~600 MB, mostly usage records), so garbage collection isn't running nonstop.
Environment=GOMEMLIMIT=3GiB
ExecStart=%h/.local/bin/cliproxyapi -config %h/.config/cliproxyapi/config.yaml
# reload starts the binary on disk, which takes the socket and becomes the main process
# while the old one finishes its in-flight requests.
ExecReload=/bin/kill -HUP $MAINPID
NotifyAccess=all
# Every agent's requests go through the proxy, so it runs ahead of the other services when the CPU is short.
CPUWeight=500
Restart=always
RestartSec=2
TimeoutStopSec=200

[Install]
WantedBy=default.target
