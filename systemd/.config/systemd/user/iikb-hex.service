[Unit]
Description=iikb: the hex extension, your hex sessions as chats in the keyboard (behind tailscale serve /hex)

[Service]
WorkingDirectory=%h/Developer/iikb
EnvironmentFile=%h/.config/iikb/hex.env
Environment=PORT=2593
ExecStart=/usr/bin/bun extensions/hex.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
