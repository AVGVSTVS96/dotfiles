[Unit]
Description=iikb: the hex extension, your hex sessions as chats in the keyboard (behind tailscale serve /hex, tailnet only, as hex's voice API is)

[Service]
WorkingDirectory=%h/Developer/iikb
Environment=PORT=2593
ExecStart=/usr/bin/bun extensions/hex.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
