[Unit]
Description=pool-vault: watch the account pool's logins and settings, which it rewrites as logins refresh

[Path]
PathChanged=%h/.config/cliproxyapi/auths
PathChanged=%h/.config/cliproxyapi/config.yaml
PathChanged=%h/.config/cliproxyapi/accounts.json
PathChanged=%h/.config/cliproxyapi/key

[Install]
WantedBy=default.target
