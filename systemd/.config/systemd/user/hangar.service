[Unit]
Description=hangar: installs and updates the development apps on the phone, over the tailnet
After=network-online.target

[Service]
WorkingDirectory=%h/Developer/hangar
# node_modules isn't synced between the server and the twin: each machine installs its own.
ExecStartPre=/usr/bin/bun install --frozen-lockfile
EnvironmentFile=%h/Developer/hangar/config
ExecStart=%h/Developer/hangar/bin/hangar serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
