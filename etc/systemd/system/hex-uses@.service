[Unit]
Description=Record what hex's work runs and reads as %i, for parity
After=local-fs.target

[Service]
StateDirectory=hex-uses
ExecStart=/bin/sh -c 'home=$(getent passwd %i | cut -d: -f6)/.; exec /usr/bin/bpftrace -q /etc/hex-uses.bt "$(id -u %i)" "$home" "$${#home}" >>/var/lib/hex-uses/%i'
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
