#!/bin/sh
# Every user service gets the shell's secrets (dotfiles zsh/secrets.env) as the user manager starts, so a machine that
# boots runs them all before anyone logs in, not only once a desktop login imports its environment.
secrets=$HOME/dotfiles/zsh/secrets.env
[ -r "$secrets" ] || exit 0
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/key.txt"
plain=$(sops -d "$secrets") || exit 0
echo "SOPS_AGE_KEY_FILE=$SOPS_AGE_KEY_FILE"
printf '%s\n' "$plain" | sh -c 'set -a; eval "$(cat)"; for name in $(sed -n "s/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p" "$1"); do eval "printf \"%s=%s\n\" $name \"\${$name-}\""; done' sh "$secrets"
