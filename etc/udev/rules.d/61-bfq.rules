# SATA SSDs use bfq, the scheduler that enforces cgroup IO weights (mq-deadline ignores them), so the hub, standby and
# the pages stay ahead on the disk while jobs saturate it. Runs after CachyOS's 60-ioschedulers.rules.
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="bfq"
