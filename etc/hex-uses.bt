// What hex's work runs and reads, for parity. Run as: bpftrace hex-uses.bt <uid> <home>/. <length of that>
// A line per path per day: "<date> run <path>" for each program started in hex's hub, sessions or jobs,
// and "<date> read <path>" for each private file opened under its user's home dot-folders.
config = { max_map_keys = 16384; max_strlen = 200 }

tracepoint:sched:sched_process_exec {
  $k = curtask->cgroups->dfl_cgrp->kn;
  if (str($k->name) == "hex.service" || str($k->__parent->name) == "hex-sessions.slice" || str($k->__parent->name) == "hex-jobs.slice") {
    $p = str(args.filename);
    if (strncmp($p, "/tmp/", 5) != 0 && !@seen[$p]) { @seen[$p] = 1; printf("%s run %s\n", strftime("%Y-%m-%d", nsecs), $p); }
  }
}

tracepoint:syscalls:sys_enter_openat /uid == $1/ {
  $k = curtask->cgroups->dfl_cgrp->kn;
  if (str($k->name) == "hex.service" || str($k->__parent->name) == "hex-sessions.slice" || str($k->__parent->name) == "hex-jobs.slice") {
    @opening[tid] = str(args.filename);
  }
}

tracepoint:syscalls:sys_exit_openat /@opening[tid] != ""/ {
  $p = @opening[tid];
  delete(@opening[tid]);
  if (args.ret >= 0 && strncmp($p, str($2), $3) == 0 && !strcontains($p, "/.claude") && !strcontains($p, "/.cache/") && !@seen[$p]) {
    // only files no one else may read: logins
    $file = (struct file *)*(curtask->files->fdt->fd + args.ret);
    if (($file->f_inode->i_mode & 077) == 0) {
      @seen[$p] = 1;
      printf("%s read %s\n", strftime("%Y-%m-%d", nsecs), $p);
    }
  }
}

interval:s:86400 { clear(@seen); }

END { clear(@seen); clear(@opening); }
