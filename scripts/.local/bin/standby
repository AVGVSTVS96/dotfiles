#!/usr/bin/env bash
# standby: one machine at a time holds hex (its hub and the Telegram bot, the Claude account pool, Gmail push): the
# server, or its cloud twin while the server is gone. The twin keeps who holds in ~/.local/state/standby/holder:
# server, taking, twin or giving. An outage sends no signal, so the twin pings the server through the tailnet every
# $EVERY seconds (Tailscale's own online flag took over 12 minutes to notice a cut-off server in a test), and takes
# over once the server has missed every ping for $GRACE seconds while the twin itself reaches the internet, growing
# first ($GROW may restart the twin: the move carries on as it boots).
# Once the server answers again, the twin releases the server's copy at once, so two hubs never poll one bot, and
# hands hex back after the server has stayed up for $STABLE seconds, then shrinks ($SHRINK). A hand-back that fails
# anywhere still ends with one machine running hex: the server if it can, else the twin again.
# The server runs a guard of its own: it stops its hex while the twin holds, and starts it whenever no machine does
# (the twin unreachable, or a hand-back stuck for $STUCK seconds). It also senses its own end coming: it holds a
# shutdown and sleep delay lock, and when a reboot, poweroff or sleep begins, hex jumps to the twin before the
# server goes, without growing it. And hex that won't start on the server jumps too.
# A move with both machines up (a jump, a hand-back) is a cut: the arriving machine starts hex ahead, ready but
# waiting (HEX_AHEAD), while everything slow happens and hex still runs here; then the hub, sessions and jobs stop
# here and what they wrote since goes down a stream that's already open, so hex is away for one trip across it and
# the hub's start. Each other piece stops on the old machine once the new one serves it.
# Each move says what happened in Telegram and on the jump page ($PAGE_DATA/jump-<role>.json).
#   standby watch      standby.service: the twin's watch, or the server's guard
#   standby may-hold   ExecCondition of every unit hex-holder.target starts, on both machines
#   standby release    stops hex here: what holds, every Claude session and job (their records resume elsewhere)
#   standby advertise  serve hex's tailnet names from here (give runs it on the server)
#   standby back [db|-] on the server: run hex here, from the twin's hex.db when give sent it ("-": ahead of a cut)
#   standby jump       on the server: move hex to the twin now (what a shutdown does)
#   standby drill [off] on the twin: act as if the server were gone, without touching it
#   standby holder | take [-] | give
set -eu
env=${STANDBY_ENV:-$HOME/.config/standby.env}
# shellcheck disable=SC1090
[ ! -f "$env" ] || . "$env"
# With no twin set up, the server always holds.
: "${ROLE:=server}" "${SERVER:=server}" "${TWIN:=twin}" "${GRACE:=60}" "${STABLE:=300}" "${GROW:=}" "${SHRINK:=}" "${BIG_CPUS:=8}" "${EVERY:=10}" "${STUCK:=900}" "${DEAD:=6}" "${SETTLE:=1}"
# The tailnet names that follow hex (Tailscale Services): the holder advertises them, the other machine drains them.
# svc:gate is Caddy, which serves every https://<name>.bassim.run. Caddy and pages run on both machines all the time,
# so a page answers from either while its name moves.
: "${SERVICES:=svc:hub svc:pages svc:updates svc:gate}"
: "${PLACE:=the $ROLE}" "${LATLON:=}" "${PAGE_DATA:=$HOME/Developer/pages/data}"
dir=$HOME/.local/state/standby
db=$HOME/hex/state/hex.db
# hex.service's HEX_AHEAD (systemd/.../hex.service.d/ahead.conf): while it exists, hex here is ready but waits.
ahead=${XDG_RUNTIME_DIR:-$dir}/hex-ahead
mkdir -p "$dir"
other=$TWIN
[ "$ROLE" != twin ] || other=$SERVER
# One connection carries every command and copy of a move, so none of them waits on a new one.
rsh=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=auto -o "ControlPath=$dir/ssh-%C" -o ControlPersist=60)
holder() { cat "$dir/holder" 2>/dev/null || echo server; }
hold() { echo "$1" > "$dir/holder.$$" && mv "$dir/holder.$$" "$dir/holder"; echo "standby: holder is $1"; }
# Sets $rtt, the server's round trip in ms, for the jump page.
up() {
  local pong
  rtt=null
  [ ! -f "$dir/drill" ] && pong=$(tailscale ping -c 1 --timeout=5s "$SERVER" 2>/dev/null) || return
  rtt=$(grep -o 'in [0-9.]*ms' <<< "$pong" | tr -dc '0-9.') || :
  rtt=${rtt:-null}
}
now() { date +%s%3N; }
since_s() { awk -v ms=$(($(now) - $1)) 'BEGIN { printf "%.1f", ms / 1000 }'; }
online() { curl -fsS -m 10 -o /dev/null https://api.telegram.org; }
big() { [ "$(nproc)" -ge "$BIG_CPUS" ]; }
on() { host=$1; shift; timeout 60 "${rsh[@]}" "$host" "$@"; }
# What standby says on the other machine. ssh lands in its login shell (fish), so the path is spelled out.
there() { local host=$1; shift; on "$host" "\"\$HOME/.local/bin/standby\" $*"; }
tell() { "$HOME/hex/.hex/bin/hex" deliver hex --to="${TELL:--1004422245734}" --user standby "$1" || :; }

# The jump page: each machine writes only its own file, which Syncthing carries to the other and pages streams.
note() { printf '{"at":%s,"on":"%s","event":"%s","detail":"%s"}\n' "$(now)" "$ROLE" "$1" "${2:-}" >> "$dir/events"; publish "${holds:-}"; }
publish() {
  [ -d "$PAGE_DATA" ] || return 0
  tail -n 30 "$dir/events" 2>/dev/null | jq -sc --arg role "$ROLE" --arg place "$PLACE" --arg latlon "$LATLON" --arg holder "$1" --argjson rtt "${rtt:-null}" --argjson seen "$(now)" \
    '{role: $role, place: $place, latlon: ($latlon | split(",") | map(tonumber)), holder: $holder, seen: $seen, rtt: $rtt, cpus: '"$(nproc)"', grace: '"$GRACE"', stable: '"$STABLE"', events: .}' > "$PAGE_DATA/.jump-$ROLE.json" &&
    mv "$PAGE_DATA/.jump-$ROLE.json" "$PAGE_DATA/jump-$ROLE.json" || :
}

may_hold() {
  case $ROLE in
    twin) case $(holder) in taking | twin) ;; *) exit 1 ;; esac ;;
    # A twin that can't be reached holds nothing the server can see: the server holds.
    # Bounded, so a twin that can't answer never keeps hex from starting.
    *) case $(twin_holds) in taking | twin) exit 1 ;; esac ;;
  esac
}

# Who holds, as the twin says, or "none" when it can't answer within 10 seconds.
twin_holds() { timeout 10 "${rsh[@]}" "$TWIN" "\"\$HOME/.local/bin/standby\" holder" 2>/dev/null || echo none; }

serve() { for service in $SERVICES; do tailscale serve "$1" "$service" >/dev/null 2>&1 || :; done; }

# Stops the sessions and jobs here. Jobs keep their records (bin/job --ended), and both resume wherever hex starts next.
rest() {
  touch "$HOME/hex/state/moving"
  systemctl --user stop hex-jobs.slice hex-sessions.slice || :
  claude daemon stop --any >/dev/null 2>&1 || :
  rm -f "$HOME/hex/state/moving"
}

release() {
  serve drain
  systemctl --user stop hex-holder.target || :
  rest
}

# Transcripts and job records written in the last 10 minutes, which Syncthing may not have carried yet.
recent() { (cd "$HOME" && find .claude/projects hex/state/jobs -mmin -10 -type f -print0 2>/dev/null); }

# Before the cut they go over whole, rsync sending what differs, with the sizes they had kept here, so the cut sends a
# transcript only what it gained since: Claude Code only ever appends to one.
carry() {
  recent | (cd "$HOME" && xargs -0r stat --printf '%s %n\0') > "$dir/carried" &&
    recent | (cd "$HOME" && rsync -a --from0 --files-from=- -e "${rsh[*]}" . "$other:")
}

# hex.db's main file goes ahead while hex runs, right after a checkpoint: SQLite writes it again only at the next one,
# so at the cut its WAL holds all that's new. $shipped is the file as it went, to tell whether it changed since.
sig() { stat -c '%s %.9Y %i' "$db" 2>/dev/null; }
ship() {
  local was
  was=$(sig)
  rsync --inplace --mkpath --copy-dest="${db%/*}" -e "${rsh[*]}" "$db" "$other:${dir#"$HOME"/}/in/hex.db" && [ "$(sig)" = "$was" ] && shipped=$was
}

# What the cut sends, as one tar: hex.db's WAL, new and rewritten files whole, and for each transcript that grew, what
# it gained, with the size it had (grew).
payload() {
  local out=$dir/out size name now
  local -A had=()
  rm -rf "$out" && mkdir -p "$out/whole" "$out/tails" && : > "$out/grew"
  [ ! -f "$db-wal" ] || cp "$db-wal" "$out/hex.db-wal"
  while IFS=' ' read -r -d '' size name; do had[$name]=$size; done < "$dir/carried"
  while IFS= read -r -d '' name; do
    now=$(stat -c %s "$HOME/$name") size=${had[$name]:-}
    if [ -n "$size" ] && [ "${name%.jsonl}" != "$name" ] && [ "$now" -ge "$size" ]; then
      [ "$now" -gt "$size" ] || continue
      mkdir -p "$out/tails/${name%/*}" && tail -c +$((size + 1)) "$HOME/$name" > "$out/tails/$name" && printf '%s %s\0' "$size" "$name" >> "$out/grew"
    else
      mkdir -p "$out/whole/${name%/*}" && cp -p "$HOME/$name" "$out/whole/$name"
    fi
  done < <(recent)
  tar -c -C "$out" .
}

# The arriving side reads the cut from the stream: when the hub stopped ($cut), then the payload, put in place.
land() {
  local in=$dir/landed size name
  read -r cut && [ -n "$cut" ] || return
  rm -rf "$in" "$dir/in/hex.db-wal" && mkdir -p "$in" && tar -x -C "$in" || return
  [ ! -f "$in/hex.db-wal" ] || mv "$in/hex.db-wal" "$dir/in/hex.db-wal"
  cp -a "$in/whole/." "$HOME/"
  while IFS=' ' read -r -d '' size name; do
    dd if="$in/tails/$name" of="$HOME/$name" bs=1M seek="$size" oflag=seek_bytes conv=notrunc status=none
  done < "$in/grew"
}

# hex here starts ahead of a cut, ready but waiting while $ahead exists. A hex that wouldn't wait would poll the bot
# alongside the other machine's, which knocks that one off.
ahead() {
  grep -q HEX_AHEAD "$HOME/hex/.hex/bin/hex" || { echo "standby: this hex can't start ahead yet" >&2; return 1; }
  ! systemctl --user is-active -q hex.service || { echo "standby: hex already runs here" >&2; return 1; }
  touch "$ahead" && systemctl --user start hex.service || return
  # Building the hub reads its code into memory, which takes a quarter second off its start on a twin that just booted.
  bun build --target=bun --outdir="$dir/warm" "$HOME/hex/.hex/hub/serve.ts" "$HOME"/hex/.hex/channels/*/bot.ts >/dev/null 2>&1 || :
  echo ready
}

# What starting ahead started, when the cut never came.
unready() { [ ! -e "$ahead" ] || { rm -f "$ahead"; systemctl --user stop hex.service || :; }; }

# The cut: the hub, sessions and jobs stop together. A session or job still going after $SETTLE seconds is killed, as
# what it wrote is on disk, and it resumes on the other machine (jobs keep their records, bin/job --ended).
stop_all() {
  touch "$HOME/hex/state/moving"
  timeout "$SETTLE" systemctl --user stop hex.service hex-jobs.slice hex-sessions.slice || {
    systemctl --user kill -s KILL hex-jobs.slice hex-sessions.slice || :
    systemctl --user stop hex.service hex-jobs.slice hex-sessions.slice || :
  }
  claude daemon stop --any >/dev/null 2>&1 || :
  rm -f "$HOME/hex/state/moving"
}

# hand <take|back>: moves hex to the other machine, which starts it ahead over the stream this opens. Litestream stops
# first, since its checkpoints write hex.db's main file. A reader kept open through the cut means the hub's close isn't
# the last, which would checkpoint too.
hand() {
  local line keep landing_PID
  systemctl --user stop hex-db.service || :
  sqlite3 -cmd '.timeout 3000' "$db" 'pragma wal_checkpoint(truncate)' >/dev/null || :
  ship || ship || { systemctl --user start hex-db.service || :; return 1; }
  carry || :
  coproc landing { on "$other" "\"\$HOME/.local/bin/standby\" $1 -"; }
  while read -r line <&"${landing[0]}" && [ "$line" != ready ]; do :; done
  [ "$line" = ready ] || { echo "standby: $other couldn't start hex ahead" >&2; wait "$landing_PID"; return 1; }
  echo "standby: $other is ready"
  sqlite3 -readonly "$db" 'select 1' '.shell sleep 60' >/dev/null 2>&1 &
  keep=$!
  cut=$(now)
  stop_all
  local to=${landing[1]}
  if [ "$(sig)" = "$shipped" ] || ship; then { echo "$cut"; payload; } >&"$to"; fi
  exec {to}>&-
  kill "$keep" 2>/dev/null || :
  echo "standby: cut sent in $(since_s "$cut")s"
  wait "$landing_PID" || return
  release
}

# arrive [db]: run hex here, from the hex.db a move or a restore put in $dir/in when told one came.
arrive() {
  if [ "${1:-}" = db ] && { [ -e "$ahead" ] || ! systemctl --user is-active -q hex.service; }; then
    mv "$dir/in/hex.db" "$db" && rm -f "$db-wal" "$db-shm" && { [ ! -f "$dir/in/hex.db-wal" ] || mv "$dir/in/hex.db-wal" "$db-wal"; }
  fi
  rm -f "$dir/in/hex.db" "$dir/in/hex.db-wal" "$ahead"
  echo "standby: hex goes here"
  systemctl --user start hex-holder.target
  serve advertise
}

# back [db|-]: the server's side of a hand-back: "-" starts hex ahead and takes the cut from the stream.
back() {
  if [ "${1:-}" = - ]; then
    { ahead && land; } || { unready; return 1; }
    arrive db
  else
    arrive "${1:-}"
  fi
}

# take [- | "" <why>]: run hex here. A jump ("-") starts hex ahead and takes the cut from the stream; after
# an outage, or when hex can't run on the server, hex starts from the copy the server streamed here (hex-db.service),
# once the twin has grown.
take() {
  local cut=${1:-} why=${2:-Lost the server}
  holds=taking
  hold taking
  if [ "$cut" = - ]; then
    { ahead && land; } || { unready; holds=server; hold server; return 1; }
    arrive db
  else
    note gone "$(date -d "@$(cat "$dir/gone" 2>/dev/null || date +%s)" '+%-I:%M:%S%p')"
    if ! big && [ -n "$GROW" ] && sh -c "$GROW"; then
      note growing
      sleep 300
      echo "standby: the twin didn't grow in 5 minutes, so hex starts at this size" >&2
    fi
    mkdir -p "$dir/in" && rm -f "$dir/in/hex.db"
    if litestream restore -o "$dir/in/hex.db" "file://$dir/hex.db"; then
      arrive db
    else
      echo "standby: no copy of hex.db from the server; hex starts from the one here" >&2
      arrive
    fi
  fi
  holds=twin
  hold twin
  [ ! -f "$dir/drill" ] || tell "Failover drill: the twin acts as if the server were gone. The server itself keeps running."
  if [ -n "$cut" ]; then
    note landed "$(since_s "$cut")"
    tell "Landed in $PLACE: hex was away for $(since_s "$cut")s. Running threads pick up where they were."
  else
    note landed
    tell "$why, so hex jumped to $PLACE ($(nproc) CPUs). Running threads pick up where they were, and hex goes home once the server stays up for $((STABLE / 60)) minutes."
  fi
}

give() {
  local start cut=""
  start=$(now)
  holds=giving
  hold giving
  note returning
  hand back || :
  if on "$SERVER" systemctl --user is-active -q hex.service; then
    holds=server
    hold server
    note home "$(since_s "${cut:-$start}")"
    on "$SERVER" "\$HOME/hex/.hex/bin/hex" deliver hex --to="${TELL:--1004422245734}" --user standby "'The server is back, and so is hex: it was away for $(since_s "${cut:-$start}")s.'" || :
    [ -z "$SHRINK" ] || ! big || sh -c "$SHRINK"
  else
    # The server can't run hex, so the twin keeps it, and tries again after the server stays up $STABLE seconds.
    holds=twin
    hold twin
    note stayed
    arrive || :
    tell "hex couldn't move back to the server, so it stays on the cloud twin and tries again in $((STABLE / 60)) minutes."
  fi
}

# The server's side: hex moves to the twin. If the twin can't take it, hex starts here again.
jump() {
  local start cut=""
  start=$(now)
  touch "$dir/jumping"
  note jumping "$1"
  tell "$1, so hex is jumping to its twin."
  if hand take; then
    note left "$(since_s "$start")"
  else
    echo "standby: the twin couldn't take hex, so it stays here" >&2
    note stayed
    arrive
  fi
  rm -f "$dir/jumping"
}

# A reboot, poweroff or sleep waits for this lock (InhibitDelayMaxSec, raised in etc/systemd/logind.conf.d) while hex
# jumps, and the server takes it again as it wakes.
sense() {
  local lock line
  lock() {
    systemd-inhibit --what=shutdown:sleep --mode=delay --who=hex --why="hex jumps to its twin first" sleep infinity &
    lock=$!
  }
  lock
  while read -r line; do
    case $line in
      *"PrepareForShutdown (true"*) jump "The server is shutting down"; pkill -P "$lock" ;;
      *"PrepareForSleep (true"*) jump "The server is going to sleep"; pkill -P "$lock" ;;
      *"PrepareForSleep (false"*) lock ;;
    esac
  done < <(gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1)
}

# The server's side: its hex runs exactly when the twin's doesn't. hex that still isn't running here $DEAD checks
# after the server started it can't run here, so it jumps.
guard() {
  local stuck="" idle=0
  # A jump this process didn't finish (standby restarted mid-way) holds the guard no longer.
  rm -f "$dir/jumping"
  while :; do
    [ ! -f "$dir/jumping" ] || { sleep "$EVERY"; continue; }
    holds=$(twin_holds)
    publish "$holds"
    case $holds in
      taking | twin) stuck="" idle=0; ! systemctl --user is-active -q hex.service || release ;;
      giving) stuck=${stuck:-$SECONDS}; [ $((SECONDS - stuck)) -lt "$STUCK" ] || idle=2 ;;
      *) stuck="" idle=$((idle + 1)) ;;
    esac
    # Stopped across two checks, so a restart in progress isn't raced.
    if [ "$idle" -ge 2 ] && ! systemctl --user is-active -q hex.service; then
      if [ "$idle" -ge "$DEAD" ] && [ "$holds" = server ] && there "$TWIN" take '""' "'hex stopped running on the server'"; then
        idle=0
      else
        echo "standby: no machine holds hex, so the server starts it" >&2
        arrive || :
      fi
    fi
    systemctl --user is-active -q hex.service && idle=0
    sleep "$EVERY"
  done
}

watch() {
  [ "$ROLE" = twin ] || { sense & guard; return; }
  # A move cut short by a restart finishes first.
  case $(holder) in taking) take ;; giving) give ;; esac
  local since=""
  while :; do
    holds=$(holder)
    case $holds in
      server)
        if up || ! online; then since="" && rm -f "$dir/gone"; else
          [ -n "$since" ] || note silent
          since=${since:-$SECONDS}
          [ -f "$dir/gone" ] || date +%s > "$dir/gone"
          [ $((SECONDS - since)) -lt "$GRACE" ] || { take; since=""; }
        fi ;;
      twin)
        if up; then
          # The server's copy stops the moment it's back, so two hubs never poll one bot.
          [ -n "$since" ] || { note back; there "$SERVER" release || :; }
          since=${since:-$SECONDS}
          [ $((SECONDS - since)) -lt "$STABLE" ] || { give; since=""; }
        else since=""; fi ;;
    esac
    publish "$(holder)"
    sleep "$EVERY"
  done
}

case "${1:-}" in
  watch) watch ;;
  may-hold) may_hold ;;
  release) release ;;
  advertise) serve advertise ;;
  holder) holder ;;
  drill) if [ "${2:-}" = off ]; then rm -f "$dir/drill"; else touch "$dir/drill"; fi ;;
  take) take "${2:-}" "${3:-}" ;;
  jump) jump "${2:-hex was told to jump}" ;;
  give) give ;;
  back) back "${2:-}" ;;
  *) echo "usage: standby watch|may-hold|release|advertise|back [db]|jump|drill [off]|holder|take|give" >&2; exit 2 ;;
esac
