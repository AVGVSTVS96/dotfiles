#!/usr/bin/env bash
# standby: one machine at a time holds hex (its hub and the Telegram bot, the Claude account pool, Gmail push): the
# server, or its cloud twin while the server is gone. The twin keeps who holds in ~/.local/state/standby/holder:
# server, taking, twin or giving. It follows Tailscale's own push of the server going offline and online, and takes
# over once the server has been offline for $GRACE seconds while
# the twin itself reaches the internet, growing first ($GROW may restart the twin: the move carries on as it boots).
# Once the server is back, the twin releases the server's copy at once, so two hubs never poll one bot, and hands
# hex back after the server has stayed up for $STABLE seconds, then shrinks ($SHRINK).
#   standby watch      the twin's standby.service
#   standby may-hold   ExecCondition of every unit hex-holder.target starts, on both machines
#   standby release    stops hex here: what holds, every Claude session and job (their records resume elsewhere)
#   standby holder | take | give
set -eu
env=${STANDBY_ENV:-$HOME/.config/standby.env}
# shellcheck disable=SC1090
[ ! -f "$env" ] || . "$env"
# With no twin set up, the server always holds.
: "${ROLE:=server}" "${SERVER:=server}" "${TWIN:=twin}" "${GRACE:=180}" "${STABLE:=300}" "${GROW:=}" "${SHRINK:=}" "${BIG_CPUS:=8}"
dir=$HOME/.local/state/standby
mkdir -p "$dir"
holder() { cat "$dir/holder" 2>/dev/null || echo server; }
hold() { echo "$1" > "$dir/holder.$$" && mv "$dir/holder.$$" "$dir/holder"; echo "standby: holder is $1"; }
# Tailscale's coordination server marks the server offline once it stops checking in, and online when it's back.
up() { tailscale status --json | jq -e --arg host "$SERVER" '[.Peer[] | select(.HostName == $host)][0].Online == true' >/dev/null; }
online() { curl -fsS -m 10 -o /dev/null https://api.telegram.org; }
big() { [ "$(nproc)" -ge "$BIG_CPUS" ]; }
on() { host=$1; shift; ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$@"; }
tell() { "$HOME/hex/.hex/bin/hex" deliver hex --to="${TELL:--1004422245734}" --user standby "$1" || :; }

may_hold() {
  case $ROLE in
    twin) case $(holder) in taking | twin) ;; *) exit 1 ;; esac ;;
    # A twin that can't be reached holds nothing the server can see: the server holds.
    *) case $(on "$TWIN" '.local/bin/standby holder' 2>/dev/null || echo server) in taking | twin) exit 1 ;; esac ;;
  esac
}

release() {
  # The jobs this stops keep their records (bin/job --ended), and resume wherever hex starts next.
  touch "$HOME/hex/state/moving"
  systemctl --user stop hex-holder.target hex-jobs.slice hex-sessions.slice || :
  claude daemon stop --any >/dev/null 2>&1 || :
  rm -f "$HOME/hex/state/moving"
}

take() {
  hold taking
  if ! big && [ -n "$GROW" ]; then sh -c "$GROW"; exec sleep infinity; fi
  systemctl --user start hex-holder.target
  hold twin
  gone=$(cat "$dir/gone" 2>/dev/null || date +%s)
  tell "The server has been unreachable since $(date -d "@$gone" '+%-I:%M%p'), so hex moved to the cloud twin ($(nproc) CPUs). Threads and jobs that were running pick up where they stopped. hex moves back once the server stays up for $((STABLE / 60)) minutes."
}

give() {
  hold giving
  release
  synced
  # hex.db moves as SQLite's own copy of it, never as a live file.
  sqlite3 "$HOME/hex/state/hex.db" ".backup '$dir/hex.db'"
  scp -q "$dir/hex.db" "$SERVER:hex/state/hex.db.standby"
  on "$SERVER" 'cd hex/state && mv hex.db.standby hex.db && rm -f hex.db-wal hex.db-shm && systemctl --user start hex-holder.target'
  hold server
  [ -z "$SHRINK" ] || ! big || sh -c "$SHRINK"
}

# Syncthing is connected to the server and has sent it every change made here (its event stream says when a
# folder's completion changes), or ten minutes passed.
synced() {
  local key peer last=0 until=$((SECONDS + 600))
  key=$(syncthing cli config gui apikey get) || key=""
  peer=$(syncthing cli config devices list | grep -vx "$(syncthing cli show system | jq -r '.myID')" | head -1) || peer=""
  api() { curl -fsS -m 70 -H "X-API-Key: $key" "http://127.0.0.1:8384/rest/$1"; }
  while [ "$SECONDS" -lt "$until" ]; do
    api system/connections | jq -e --arg peer "$peer" '.connections[$peer].connected' >/dev/null 2>&1 &&
      [ "$(api "db/completion?device=$peer" | jq '.needBytes')" = 0 ] && return
    last=$(api "events?events=FolderCompletion,DeviceConnected&since=$last&timeout=60" | jq '[.[].id] | max // '"$last") || sleep 60
  done
  echo "standby: Syncthing hadn't sent everything after 10 minutes; handing back anyway" >&2
}

# Wakes on each message Tailscale pushes, and when the grace or stable period it waits out ends.
watch() {
  # A move cut short by a restart finishes first.
  case $(holder) in taking) take ;; giving) give ;; esac
  local since="" period wait
  while :; do
    case $(holder) in
      server)
        if up || ! online; then since="" && rm -f "$dir/gone"; else
          since=${since:-$SECONDS}
          [ -f "$dir/gone" ] || date +%s > "$dir/gone"
          [ $((SECONDS - since)) -lt "$GRACE" ] || { take; since=""; }
        fi ;;
      twin)
        if up; then
          # The server's copy stops the moment it's back, so two hubs never poll one bot.
          [ -n "$since" ] || on "$SERVER" '.local/bin/standby release' || :
          since=${since:-$SECONDS}
          [ $((SECONDS - since)) -lt "$STABLE" ] || { give; since=""; }
        else since=""; fi ;;
    esac
    period=$GRACE && [ "$(holder)" != twin ] || period=$STABLE
    wait=86400 && [ -z "$since" ] || wait=$((period - (SECONDS - since) + 1))
    read -r -t "$wait" _ <&3 || [ $? -gt 128 ] || exec 3< <(tailscale debug watch-ipn)
  done 3< <(tailscale debug watch-ipn)
}

case "${1:-}" in
  watch) watch ;;
  may-hold) may_hold ;;
  release) release ;;
  holder) holder ;;
  take) take ;;
  give) give ;;
  *) echo "usage: standby watch|may-hold|release|holder|take|give" >&2; exit 2 ;;
esac
