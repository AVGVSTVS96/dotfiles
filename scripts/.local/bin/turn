#!/bin/sh
# turn <command...>: runs a heavy command (a build, test suite, simulator or browser run) once one of this machine's
# TURN_SLOTS turns (2 by default) is free, at the lowest CPU priority, so heavy work from every project and agent takes
# turns instead of all running at once. Through ~/.local/share/turn, first on PATH in .zshenv, xtool, swift and
# xcodebuild builds and tests take a turn by themselves, their other commands run straight away, and microscope
# reviews, each a team of agents, take turns of their own (TURN_POOL=reviews), and `xcrun simctl boot` waits while SIMULATORS (2) are booted, starting 2 minutes after the last boot at the soonest.
# Simulator test runs (xcodebuild test, or a check run as TURN_POOL=sims) take turns of their own too, since they mostly
# wait on a simulator that's already booted, so they don't queue behind builds and benchmarks, nor those behind them.
# A check's own xcodebuilds, its UI tests' build included, run inside its turn.
# Waiting runs take turns in the order they came; TURN_FIRST=1 puts one that someone is waiting on first.
# ~/.config/turn/<pool> holds a pool's number of turns when it should differ from TURN_SLOTS, as while the Mac recovers.
# A new turn or simulator boot also waits while memory pressure isn't normal or less than a quarter of the CPU is idle (roomy).
set -e
name=${0##*/}
# Whether the machine has room for another simulator or build: macOS's memory pressure is normal, not warn or
# critical, and a quarter of its CPU is idle, since simulators, builds and installs starting together on Nov 8 took
# the Mac's load past 595, where loginwindow crashed and logged Bassim out. Free swap isn't a signal, since macOS
# grows and shrinks swap as it goes. Always true where there's no such sysctl.
roomy() {
  level=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null) || return 0
  [ "$level" = 1 ] && [ "$(top -l 2 -n 0 -s 1 | awk '/CPU usage/ { idle = $7 } END { print int(idle) }')" -ge 25 ]
}
memory() { echo "memory pressure $(sysctl -n kern.memorystatus_vm_pressure_level) (1 is normal), $(sysctl -n vm.swapusage), $(top -l 1 -n 0 | grep "CPU usage"), $(pmset -g batt | head -1)"; }
if [ "$name" != turn ]; then
  shims=$(cd "${0%/*}" && pwd -P)
  real=
  IFS=:
  for dir in $PATH; do
    [ -d "$dir" ] && [ "$(cd "$dir" && pwd -P)" != "$shims" ] && [ -x "$dir/$name" ] && { real=$dir/$name; break; }
  done
  unset IFS
  [ -n "$real" ] || { echo "turn: no $name on PATH besides $shims" >&2; exit 127; }
  case "$name $*" in "xcodebuild "*test-without-building* | "xcodebuild "*" test" | "xcodebuild "*" test "*)
    export TURN_POOL=${TURN_POOL:-sims} ;;
  esac
  # Inside a simulator check's turn, its xcodebuilds (building and running its UI tests) are that check.
  case "$name ${TURN:-}" in "xcodebuild "*sims*) exec "$real" "$@" ;; esac
  case "$name $*" in
    "xtool dev"* | "swift build"* | "swift test"* | "swift run"*) ;;
    "microscope review"*) export TURN_POOL=reviews ;;
    "xcrun simctl boot "* | "xcrun simctl bootstatus "*"-b"*)
      # A simulator boots only while fewer than SIMULATORS (2) are booted and memory has room, one boot starting at a
      # time. The wait for room happens outside the lock, and a boot holds the lock 10 minutes at most, so no stuck
      # boot blocks the machine's others.
      id=$(echo "$3" | grep -E '^[0-9A-F-]{36}$' || "$real" simctl list devices | sed -n "s/^ *$3 (\([0-9A-F-]\{36\}\)).*/\1/p" | head -1)
      [ -n "$id" ] || exec "$real" "$@"
      is_booted() { "$real" simctl list devices booted | grep -q "($id) (Booted)"; }
      # Simulators boot only to reproduce a bug a run is chasing (SIM_REPRO=1): Bassim checks changes on his Duo, and on
      # Nov 8 simulators cost two Mac lockups, a logout and a forced restart for little they found.
      if [ -z "${SIM_REPRO:-}${TURN_SIMULATOR:-}" ] && ! is_booted; then
        echo "turn: simulators are off; check the change on the Duo, or set SIM_REPRO=1 to boot one for a bug you're reproducing" >&2
        exit 1
      fi
      # A booted simulator is in use while a process outside it names it, by id or name, or for 5 minutes after it
      # boots or an app starts on it, since a check names its simulator only in short simctl calls and launches its app
      # for each state. An app left running longer, like a probe a run left open, doesn't count. One out of use for 30
      # seconds is idle, since runs leave theirs booted for the next one; a waiting boot shuts one down, also when the CPU is short, since idle simulators can keep it so.
      used() {
        ps -Ao etime=,command= | awk -v id="$1" -v sim="$2" '
          function age(etime, part, n) {
            n = split(etime, part, /[-:]/)
            return part[n] + 60 * part[n - 1] + (n > 2 ? 3600 * part[n - 2] : 0) + (n > 3 ? 86400 * part[1] : 0)
          }
          (index($0, "CoreSimulator/Devices/" id "/data/Containers/Bundle/") ||
            (index($0, "CoreSimulator/Devices/" id "/") && / launchd_sim /)) && age($1) < 300 { found = 1 }
          !index($0, "CoreSimulator/Devices/") && !/awk -v id/ && (index($0, id) || index($0, sim)) { found = 1 }
          END { exit !found }'
      }
      free_idle() {
        "$real" simctl list devices booted | sed -n 's/^ *\(.*\) (\([0-9A-F-]\{36\}\)) (Booted).*/\2 \1/p' |
          while read -r other sim; do
            used "$other" "$sim" && continue
            sleep 30
            used "$other" "$sim" || { "$real" simctl shutdown "$other"; break; }
          done
      }
      wait_for_room() {
        while [ "$("$real" simctl list devices booted | grep -c '(Booted)')" -ge "${SIMULATORS:-2}" ] || ! roomy; do
          free_idle
          [ -n "$told" ] || { echo "turn: $id boots once fewer than ${SIMULATORS:-2} simulators are booted and memory has room ($(memory)); booted:" >&2; "$real" simctl list devices booted | grep '(Booted)' >&2; told=1; }
          sleep 5
        done
      }
      told=
      if [ -z "${TURN_SIMULATOR:-}" ]; then
        if ! is_booted; then
          wait_for_room
          mkdir -p "/tmp/turn-$(id -u)"
          TURN_SIMULATOR=1 lockf -k "/tmp/turn-$(id -u)/simulators" "$0" simctl boot "$id" || true
        fi
        [ "$2" = boot ] && is_booted && exit 0
        exec "$real" "$@"
      fi
      # Under the lock: room again, and 2 minutes since the last boot started, then the boot started and waited on
      # for 10 minutes at most. Each boot starts ~300 iOS services at once; on Nov 8, 8 boots in 30 minutes took the
      # Mac's load to 595 and crashed loginwindow, logging Bassim out.
      is_booted && exit 0
      wait_for_room
      last=/tmp/turn-$(id -u)/last-boot
      while [ -e "$last" ] && [ $(($(date +%s) - $(stat -c %Y "$last" 2>/dev/null || stat -f %m "$last"))) -lt 120 ]; do sleep 5; done
      touch "$last"
      # It boots without its wallpaper, widget and Live Activity services, a third of a fresh simulator's CPU that no
      # test needs (measured Nov 3: 295 → 193 CPU-s in its first 2 minutes), or the Siri, Apple Intelligence, routine,
      # usage, mail, photos and device-management daemons iOS 27.1's simulators crash-loop (1,025 crash reports by
      # Nov 5, each also costing ReportCrash CPU). Its launchd reads them from this file.
      off=/private/var/tmp/com.apple.CoreSimulator.SimDevice.$id/disabled.plist
      mkdir -p -m 700 "${off%/*}"
      # SIM_WIDGETS=1 keeps the widget and App Intents services, which Control Center's third-party controls need.
      widgets="com.apple.chronod com.apple.siriactionsd"
      if [ -n "${SIM_WIDGETS:-}" ]; then
        for label in $widgets; do /usr/libexec/PlistBuddy -c "Set :$label false" "$off" 2>/dev/null || true; done
        widgets=
      fi
      for label in com.apple.PosterBoard $widgets com.apple.liveactivitiesd com.apple.intelligencetasksd \
        com.apple.siriinferenced com.apple.siriknowledged com.apple.assistantd com.apple.routined \
        com.apple.UsageTrackingAgent com.apple.nanoprefsyncd.2 com.apple.dmd com.apple.email.maild com.apple.assetsd \
        com.apple.ScreenTimeAgent com.apple.sirittsd com.apple.modelmanagerd; do
        /usr/libexec/PlistBuddy -c "Set :$label true" "$off" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :$label bool true" "$off" >/dev/null
      done
      "$real" simctl boot "$id" 2>/dev/null || true
      held=0
      until is_booted || [ "$held" -ge 600 ]; do
        sleep 3
        held=$((held + 3))
      done
      exit 0 ;;
    xcodebuild*-version* | xcodebuild*-showsdks* | xcodebuild*-list* | xcodebuild*-showBuildSettings* | xcodebuild*-find*) exec "$real" "$@" ;;
    xcodebuild*Simulator*id=*)
      id=$(echo "$*" | sed -n 's/.*id=\([0-9A-Fa-f-]\{36\}\).*/\1/p')
      [ -z "$id" ] || "$shims/xcrun" simctl boot "$id" >/dev/null || exit 1 ;;
    xcodebuild*) ;;
    *) exec "$real" "$@" ;;
  esac
  set -- "$real" "$@"
fi
[ $# -gt 0 ] || { echo "usage: turn <command...>" >&2; exit 2; }
pool=${TURN_POOL:-runs}
unset TURN_POOL
case " ${TURN:-} " in *" $pool "*) exec "$@" ;; esac

dir=/tmp/turn-$(id -u)/$pool
mkdir -p "$dir"
# flock on Linux, lockf on macOS: both hold the lock while the command runs and give it back when it exits.
if command -v flock >/dev/null; then lock="flock -o" try="flock -n"; else lock="lockf -k" try="lockf -k -t 0"; fi
# Waiting runs take turns in the order they came, by ticket, and TURN_FIRST=1 puts a run that someone is waiting on
# ahead of the rest. A ticket whose run has gone is dropped.
mkdir -p "$dir.queue"
ticket=$dir.queue/$([ -n "${TURN_FIRST:-}" ] && echo 0 || echo 1)-$(date +%s)-$$
echo "$PWD: $*" > "$ticket"
unset TURN_FIRST
told=
while :; do
  for waiting in "$dir.queue"/*; do
    kill -0 "${waiting##*-}" 2>/dev/null || rm -f "$waiting"
  done
  # Turns start 20 seconds apart in every pool, so roomy sees the last start's load before the next one: on Nov 8 at
  # 9:25 a queue that found room all started at once, and Bassim had to force-restart the Mac.
  last=/tmp/turn-$(id -u)/last-start
  if [ "$pool" != reviews ] && { ! roomy || { [ -e "$last" ] && [ $(($(date +%s) - $(stat -c %Y "$last" 2>/dev/null || stat -f %m "$last"))) -lt 20 ]; }; }; then
    [ "$told" = memory ] || { echo "turn: the next $pool turn waits for room: $(memory)" >&2; told=memory; }
    sleep 5
    continue
  fi
  if [ "$(ls "$dir.queue" | sort -t- -k1,1 -k2,2n | head -1)" != "${ticket##*/}" ]; then
    [ -n "$told" ] || { echo "turn: waiting in line for a $pool turn, behind:" >&2; ls "$dir.queue" | sort -t- -k1,1 -k2,2n |
      sed "/^${ticket##*/}\$/,\$d" | while read -r t; do cat "$dir.queue/$t"; done >&2; told=1; }
    sleep 2
    continue
  fi
  # A run that has held its turn for TURN_MINUTES (30), like a dev server or a watcher, stops counting.
  limit=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/turn/$pool" 2>/dev/null || echo "${TURN_SLOTS:-2}")
  for who in $(find "$dir" -name '*.who' -mmin +"${TURN_MINUTES:-30}"); do
    $try "${who%.who}" true 2>/dev/null || limit=$((limit + 1))
  done
  slot=1
  while [ "$slot" -le "$limit" ]; do
    if $try "$dir/$slot" true 2>/dev/null; then
      printf '%s %s: %s\n' "$(date +%H:%M)" "$PWD" "$*" > "$dir/$slot.who"
      export TURN="${TURN:+$TURN }$pool"
      rm -f "$ticket"
      mkdir -p "${last%/*}" && touch "$last"
      exec $lock "$dir/$slot" nice -n 19 "$@"
    fi
    slot=$((slot + 1))
  done
  [ "$told" = taken ] || { echo "turn: every $pool turn on this machine is taken; next in line, waiting for one of these to finish:" >&2; cat "$dir"/*.who >&2; told=taken; }
  sleep 2
done
