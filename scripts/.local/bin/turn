#!/bin/sh
# turn <command...>: runs a heavy command (a build, test suite, simulator or browser run) once one of this machine's
# TURN_SLOTS turns (2 by default) is free, at the lowest CPU priority, so heavy work from every project and agent takes
# turns instead of all running at once. Through ~/.local/share/turn, first on PATH in .zshenv, xtool, swift and
# xcodebuild builds and tests take a turn by themselves, their other commands run straight away, and microscope
# reviews, each a team of agents, take turns of their own (TURN_POOL=reviews), and `xcrun simctl boot` waits while SIMULATORS (3) are booted.
set -e
name=${0##*/}
if [ "$name" != turn ]; then
  shims=$(cd "${0%/*}" && pwd -P)
  real=
  IFS=:
  for dir in $PATH; do
    [ -d "$dir" ] && [ "$(cd "$dir" && pwd -P)" != "$shims" ] && [ -x "$dir/$name" ] && { real=$dir/$name; break; }
  done
  unset IFS
  [ -n "$real" ] || { echo "turn: no $name on PATH besides $shims" >&2; exit 127; }
  case "$name $*" in
    "xtool dev"* | "swift build"* | "swift test"* | "swift run"*) ;;
    "microscope review"*) export TURN_POOL=reviews ;;
    "xcrun simctl boot "* | "xcrun simctl bootstatus "*"-b"*)
      # A simulator boots only while fewer than SIMULATORS (3) are booted on this machine, one boot at a time.
      booted=$("$real" simctl list devices booted | grep '(Booted)' || true)
      case "$booted" in *"($3)"* | *" $3 ("*) exec "$real" "$@" ;; esac
      if [ -z "${TURN_SIMULATOR:-}" ]; then
        mkdir -p "/tmp/turn-$(id -u)"
        export TURN_SIMULATOR=1
        exec lockf -k "/tmp/turn-$(id -u)/simulators" "$0" "$@"
      fi
      told=
      while [ "$(printf '%s' "$booted" | grep -c '(Booted)')" -ge "${SIMULATORS:-3}" ]; do
        [ -n "$told" ] || { echo "turn: ${SIMULATORS:-3} simulators are booted; $3 boots once one shuts down:" >&2; echo "$booted" >&2; told=1; }
        sleep 5
        booted=$("$real" simctl list devices booted | grep '(Booted)' || true)
      done
      # It boots without its wallpaper, widget and Live Activity services, a third of a fresh simulator's CPU that no
      # test needs (measured Nov 3: 295 → 193 CPU-s in its first 2 minutes). Its launchd reads them from this file.
      id=$(echo "$3" | grep -E '^[0-9A-F-]{36}$' || "$real" simctl list devices | sed -n "s/^ *$3 (\([0-9A-F-]\{36\}\)).*/\1/p" | head -1)
      if [ -n "$id" ]; then
        off=/private/var/tmp/com.apple.CoreSimulator.SimDevice.$id/disabled.plist
        mkdir -p -m 700 "${off%/*}"
        for label in com.apple.PosterBoard com.apple.chronod com.apple.liveactivitiesd; do
          /usr/libexec/PlistBuddy -c "Set :$label true" "$off" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :$label bool true" "$off" >/dev/null
        done
      fi
      exec "$real" "$@" ;;
    xcodebuild*-version* | xcodebuild*-showsdks* | xcodebuild*-list* | xcodebuild*-showBuildSettings* | xcodebuild*-find*) exec "$real" "$@" ;;
    xcodebuild*Simulator*id=*)
      id=$(echo "$*" | sed -n 's/.*id=\([0-9A-Fa-f-]\{36\}\).*/\1/p')
      [ -z "$id" ] || "$shims/xcrun" simctl boot "$id" >/dev/null 2>&1 || true ;;
    xcodebuild*) ;;
    *) exec "$real" "$@" ;;
  esac
  set -- "$real" "$@"
fi
[ $# -gt 0 ] || { echo "usage: turn <command...>" >&2; exit 2; }
pool=${TURN_POOL:-runs}
unset TURN_POOL
case " ${TURN:-} " in *" $pool "*) exec "$@" ;; esac

dir=/tmp/turn-$(id -u)/$pool
mkdir -p "$dir"
# flock on Linux, lockf on macOS: both hold the lock while the command runs and give it back when it exits.
if command -v flock >/dev/null; then lock="flock -o" try="flock -n"; else lock="lockf -k" try="lockf -k -t 0"; fi
told=
while :; do
  # A run that has held its turn for TURN_MINUTES (30), like a dev server or a watcher, stops counting.
  limit=${TURN_SLOTS:-2}
  for who in $(find "$dir" -name '*.who' -mmin +"${TURN_MINUTES:-30}"); do
    $try "${who%.who}" true 2>/dev/null || limit=$((limit + 1))
  done
  slot=1
  while [ "$slot" -le "$limit" ]; do
    if $try "$dir/$slot" true 2>/dev/null; then
      printf '%s %s: %s\n' "$(date +%H:%M)" "$PWD" "$*" > "$dir/$slot.who"
      export TURN="${TURN:+$TURN }$pool"
      exec $lock "$dir/$slot" nice -n 19 "$@"
    fi
    slot=$((slot + 1))
  done
  [ -n "$told" ] || { echo "turn: every $pool turn on this machine is taken; waiting for one of these to finish:" >&2; cat "$dir"/*.who >&2; told=1; }
  sleep 2
done
