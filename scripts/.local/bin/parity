#!/bin/sh
# parity [<machine>]: gives <machine>, the twin by default, what hex's work ran and read on this machine in the last
# 60 days, and tells hex in one line what it couldn't. hex-uses@.service records what hex uses; the folders Syncthing
# shares are the twin's already; ~/dotfiles/standby/off-twin says what stays off it, and why.
# parity --lacks: run on the twin, prints the lines of "<kind> <path> <name>" on stdin it lacks.
set -eu

if [ "${1-}" = --lacks ]; then
  # hex's own PATH, as its sessions and jobs start with it
  hex=$(systemctl --user show hex.service -p Environment --value | tr ' ' '\n' | sed -n 's/^PATH=//p')
  PATH=${hex:-$PATH}
  while read -r kind path name; do
    [ -e "$path" ] && continue
    # the same tool at another version
    for other in $(printf %s "$path" | sed 's#/[^/]*[0-9]\.[0-9][^/]*#/*#g'); do [ -e "$other" ] && continue 2; done
    [ "$kind" = run ] && command -v "$name" >/dev/null && continue
    echo "$kind $path $name"
  done
  exit 0
fi

machine=${1:-twin}
record=/var/lib/hex-uses/$(id -un)
off=$HOME/dotfiles/standby/off-twin
state=${XDG_STATE_HOME:-$HOME/.local/state}/parity
mkdir -p "$state"
# Two months sees a monthly job twice.
since=$(date -d '60 days ago' +%F)
# Nothing new since a check less than a day old: nothing to do.
awk -v since="$since" '$1 >= since { sub(/^[^ ]+ /, ""); print }' "$record" | sort -u >"$state/seen.new"
if [ -n "$(find "$state/seen" -mmin -1440 2>/dev/null)" ] && [ -z "$(comm -13 "$state/seen" "$state/seen.new")" ]; then exit 0; fi
shared=$(for f in $(syncthing cli config folders list); do syncthing cli config folders "$f" path get; done)

in_shared() { printf '%s\n' "$shared" | while read -r dir; do case $1 in "$dir" | "$dir"/*) echo yes; break ;; esac; done; }

# A home path's folder as a tool keeps it: ~/.codex, ~/.config/gcloud, ~/.local/share/gh.
entry() {
  case ${1#"$HOME"/} in
    .config/* | .local/share/*) echo "$1" | cut -d/ -f1-6 ;;
    *) echo "$1" | cut -d/ -f1-4 ;;
  esac
}

# What hex ran, and the private files it read (logins), that still exist here, outside Syncthing's folders and what
# makes itself again (temp, cache, state): "<kind> <path the twin needs> <its name, or for a file its folder>".
used() {
  while read -r kind path; do
    [ -e "$path" ] || continue
    real=$(realpath "$path" 2>/dev/null) || continue
    case $real in /tmp/* | /proc/* | /dev/* | /run/* | "$HOME"/.cache/* | "$HOME"/.local/state/*) continue ;; esac
    [ -z "$(in_shared "$real")" ] || continue
    if [ "$kind" = run ]; then
      echo "run $path ${path##*/}"
      # The kernel starts a script's interpreter unseen.
      [ "$(head -c2 "$real")" != '#!' ] ||
        head -1 "$real" | awk '{ sub(/^#! */, ""); if ($1 ~ /\/env$/) { if ($2 == "-S") $2 = $3; print "run /usr/bin/" $2 " " $2 } else print "run " $1 " " $1 }'
    elif [ "$(stat -c %a "$real" | cut -c2-)" = 00 ]; then
      echo "read $path $(entry "$path")"
    fi
  done <"$state/seen.new" | sort -u
}

# How the twin gets one: "pacman <package>", "bun <package> <its global folder> <bin folder>" (where this machine has
# them), "uv <tool>", or "by-hand <what to name>".
source_of() {
  real=$(realpath "$2")
  case $2 in "$HOME"/.local/share/uv/tools/*) real=$2 ;; esac
  case $real in
    "$HOME"/*/node_modules/*) echo "$real" | sed -E "s#(.*)/node_modules/((@[^/]+/)?[^/]+)/.*#bun \2 \1 ${2%/*}#" ;;
    "$HOME"/.local/share/uv/tools/*) echo "uv $(echo "$real" | cut -d/ -f8)" ;;
    "$HOME"/*) [ "$1" = read ] && set -- "$1" "$3"; echo "by-hand ~/${2#"$HOME"/}" ;;
    *) pkg=$(pacman -Qoq "$real" 2>/dev/null) && echo "pacman $pkg" || echo "by-hand $2" ;;
  esac
}

# What the twin lacks, as source_of says, less what off-twin keeps off it (by package, folder or command name).
needs() {
  ssh -o BatchMode=yes -o ConnectTimeout=15 "$machine" .local/bin/parity --lacks | while read -r kind path name; do
    echo "$(source_of "$kind" "$path" "$name") ${name##*/}"
  done | awk -v off="$off" 'BEGIN { while ((getline line < off) > 0) if (line !~ /^#/ && split(line, f)) keep[f[1]] }
    { for (k in keep) if ($2 == k || index($2, k "/") == 1 || $NF == k) next; NF--; print }' | sort -u
}

uses=$(used)
needed=$(printf '%s\n' "$uses" | needs) || { echo "parity: can't reach $machine" >&2; exit 2; }
# Only what the twin's own repositories have: the rest (AUR, the server's own repositories) stays a gap.
pacman=$(printf '%s\n' "$needed" | sed -n 's/^pacman //p')
[ -z "$pacman" ] || pacman=$(ssh "$machine" pacman -Slq | grep -xF "$pacman" | sort -u | xargs) || :
bun=$(printf '%s\n' "$needed" | sed -n 's/^bun //p')
uv=$(printf '%s\n' "$needed" | sed -n 's/^uv //p' | xargs)
# keeping no downloads, on the twin's small disk
[ -z "$pacman" ] || ssh -n "$machine" "{ sudo pacman -S --needed --noconfirm $pacman || sudo pacman -Syu --needed --noconfirm $pacman; } && sudo find /var/cache/pacman/pkg -type f -delete" >&2 || :
# into the same folders as here, so hex's PATH finds them there too
printf '%s\n' "$bun" | while read -r pkg dir bin; do
  [ -z "$pkg" ] || ssh -n "$machine" "env BUN_INSTALL_GLOBAL_DIR=$dir BUN_INSTALL_BIN=$bin bun add -g $pkg" >&2 || :
done
# --force: the link ~/.local/bin already has from here
for tool in $uv; do ssh -n "$machine" "uv tool install --force $tool" >&2 || :; done

[ -z "$pacman$bun$uv" ] && gaps=$needed || gaps=$(printf '%s\n' "$uses" | needs)
gaps=$(printf '%s\n' "$gaps" | cut -d' ' -f2 | sed '/^$/d')
touch "$state/gaps"
new=$(printf '%s\n' "$gaps" | grep -vxFf "$state/gaps") || :
printf '%s\n' "$gaps" >"$state/gaps"
mv "$state/seen.new" "$state/seen"
[ -n "$gaps" ] || exit 0
echo "$machine lacks: $(printf '%s\n' "$gaps" | paste -sd ' ')"
if [ -n "$new" ]; then
  new=$(printf '%s\n' "$new" | paste -sd ' ' | sed 's/ /, /g')
  thread=$("$HOME/hex/.hex/bin/hex" threads | awk 'NF == 3 && $3 == "Selfheal" { print $2 }')
  "$HOME/hex/.hex/bin/hex" deliver hex --to="$thread" --beside --user parity "parity, the check that the twin can do what the server does, found what hex's work used on the server in the last two months and the $machine lacks: $new. Tell Bassim in one plain line, then get it onto the $machine or add it to ~/dotfiles/standby/off-twin with why it stays off."
fi
exit 1
