#!/bin/sh
# edd-tab arm <YYYY-MM-DD> | disarm | open
# From three days before an armed EDD deadline until hex disarms it, open puts EDD's UI Online in front
# in Dia: the tab already on it (it signs in on myedd.edd.ca.gov), or a new one. An overdue deadline
# keeps opening, since a missed one is the one he most needs to see. hex arms it from the unemployment
# topic.
set -eu
due=~/.config/edd-tab/due
case ${1:-} in
arm)
  [ -n "${2:-}" ] && [ "$(date -j -f %F "$2" +%F 2>/dev/null)" = "$2" ] || { echo "edd-tab: arm takes a YYYY-MM-DD date" >&2; exit 2; }
  mkdir -p "${due%/*}" && echo "$2" >"$due"
  ;;
disarm) rm -f "$due" ;;
open)
  [ -f "$due" ] || exit 0
  [ "$(date -v+3d +%F)" \< "$(cat "$due")" ] && exit 0
  osascript <<'APPLESCRIPT' | grep -q . || open -a Dia https://uio.edd.ca.gov/UIO/Pages/Public/LandingPage.aspx
tell application "Dia"
  repeat with w in windows
    repeat with t in tabs of w
      if URL of t contains "uio.edd.ca.gov" or URL of t contains "myedd.edd.ca.gov" then
        focus t
        activate
        return "found"
      end if
    end repeat
  end repeat
  return ""
end tell
APPLESCRIPT
  ;;
*) echo "usage: edd-tab arm <YYYY-MM-DD> | disarm | open" >&2; exit 2 ;;
esac
