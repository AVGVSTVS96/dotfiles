{
  "enabledPlugins": {
    "paper-desktop@paper": true
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "launchctl kickstart gui/$(id -u)/dev.commonplace.sync > /dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
