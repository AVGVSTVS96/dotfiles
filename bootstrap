#!/bin/sh
# Set up this Mac or Arch/CachyOS machine from ~/dotfiles. Safe to rerun:
# whatever is already installed is detected and left alone.
set -eu
cd "$(dirname "$0")"
export PATH="$HOME/.local/bin:$HOME/.local/share/fnm/aliases/default/bin:$PATH"
export CODEX_NON_INTERACTIVE=1

have() { command -v "$1" >/dev/null 2>&1; }

run_installer() { # url command...
  installer=$(curl -fsSL "$1")
  shift
  printf '%s\n' "$installer" | "$@"
}

ensure() { # command installer-url interpreter
  if have "$1"; then
    echo "✓ $1 already installed: $(command -v "$1")"
  else
    run_installer "$2" "$3"
  fi
}

# On Linux, files that already exist where stow links are adopted. Ones still identical
# to the distro's /etc/skel copy are replaceable defaults, so the repo version wins; any
# other file is the user's own work and stays adopted for review. Originals are backed up.
link() {
  if [ "$(uname -s)" != Linux ]; then
    ./install || { echo "Move the files stow reports above aside, then rerun ./bootstrap"; exit 1; }
    return
  fi
  adopt=$(./install -n -v --adopt 2>&1 | sed -n 's/^MV: \(.*\) -> .*/\1/p')
  [ -n "$adopt" ] || { ./install; return; }
  git diff --quiet HEAD || { echo "$(pwd) has uncommitted changes; commit or stash them, then rerun"; exit 1; }
  backup="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  printf '%s\n' "$adopt" | while IFS= read -r f; do
    mkdir -p "$backup/$(dirname "$f")" && cp -p "$HOME/$f" "$backup/$f"
  done
  ./install --adopt
  printf '%s\n' "$adopt" | while IFS= read -r f; do
    if cmp -s "$HOME/$f" "/etc/skel/$f"; then git checkout -- "$(realpath "$HOME/$f")"; fi
  done
  echo "Backed up the originals of $(printf '%s\n' "$adopt" | wc -l | tr -d ' ') files to $backup"
  git diff --quiet || { echo "Kept your own versions of these; review with: git -C $(pwd) diff"; git --no-pager diff --stat; }
}

case "$(uname -s)" in
  Darwin)
    brew bundle --no-upgrade --file brew/Brewfile
    ;;
  Linux)
    xargs pacman -T < arch/pacman.txt >/dev/null || sudo pacman -Syu --needed - < arch/pacman.txt
    if ! xargs pacman -T < arch/aur.txt >/dev/null; then
      if have paru; then paru -S --needed - < arch/aur.txt; else echo "paru not found: skipped arch/aur.txt"; fi
    fi
    ensure claude https://claude.ai/install.sh bash
    ensure codex https://chatgpt.com/codex/install.sh sh
    ensure herdr https://herdr.dev/install.sh sh
    ensure t3 https://t3.codes/install.sh sh
    ;;
esac

link

case "$SHELL" in
  */zsh)
    [ -d "$HOME/.oh-my-zsh" ] ||
      run_installer https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh sh -s -- --unattended --keep-zshrc
    ;;
esac
[ -e "$HOME/.local/share/fnm/aliases/default" ] || { fnm install --lts && fnm default lts-latest; }
have gt || npm install -g @withgraphite/graphite-cli@stable
if have rustup; then
  rustup default >/dev/null 2>&1 || rustup default stable
  rustup component add rust-analyzer
  # rustup acts as whichever tool it's named after; Arch's rustup links cargo and rustc only.
  have rust-analyzer || ln -s "$(command -v rustup)" "$HOME/.local/bin/rust-analyzer"
fi
# HERDR_ENV lets the herdr-only navigator plugin install too, which builds its helper.
# On a fresh install lazy.nvim rewrites the lockfile before LazyVim's own plugin specs load,
# so those land on their latest commits; a second start restores every plugin to the lockfile.
# The lockfile is reset after each start: machines without the side-project checkouts only
# add entries for those two plugins.
lazy() {
  HERDR_ENV=1 nvim --headless "$@" +qa
  git checkout -- nvim/.config/nvim/lazy-lock.json
}
have vim-herdr-navigator || { lazy; lazy "+Lazy! restore"; }
herdr plugin list | grep -q '^- drovr ' || herdr plugin install --yes AVGVSTVS96/herdr-drovr

if [ -r "$HOME/.config/sops/age/key.txt" ]; then
  scripts/.local/bin/restore-secrets
else
  echo "Copy the existing age key to ~/.config/sops/age/key.txt, then run restore-secrets"
fi

echo "Agent CLIs seen by non-interactive $(basename "$SHELL") (ssh commands, T3 Code):"
for c in claude codex herdr t3; do
  printf '  %s: %s\n' "$c" "$("$SHELL" -c "command -v $c" 2>/dev/null || echo missing)"
done
